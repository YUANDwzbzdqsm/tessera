{
  "name": "tessera-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build:sandbox": "node scripts/build-sandbox.mjs",
    "dev": "npm run build:sandbox && npm run dev -w @tessera/demo",
    "build": "npm run build:sandbox && npm run build -w @tessera/demo",
    "test": "vitest run",
    "test:sandbox": "vitest run -c vitest.sandbox.config.ts",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run test:sandbox"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright-core": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "5.0.5"
  }
}
